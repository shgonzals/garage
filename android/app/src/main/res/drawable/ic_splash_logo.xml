    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M18,54 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0"
        android:fillColor="#FFF5C518" />
    <!-- La G al 80 %: con el tamaño del icono del escritorio quedaba pegada al borde del círculo. -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.8" android:scaleY="0.8">
    <path
        android:pathData="M73.9,37.3 A26,26 0 1,0 80,54"
        android:strokeColor="#FF14171B"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
