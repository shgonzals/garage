        android:strokeColor="#FF14171B"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M48.5,54 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
        android:fillColor="#FF14171B" />
    <path
        android:pathData="M51.8,54 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FFF5C518" />
    </group>
